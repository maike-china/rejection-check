    "cordis.patch.yml",
    "SKILL.md",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "skill",
    "tender",
    "bid",
    "rejection-check"
  ],
  "license": "MIT",
  "dependencies": {
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
